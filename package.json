{
  "name": "cache-sweeper",
  "displayName": "VS Code Cleaner",
  "description": "Free the disk space VS Code never cleans up itself: C/C++ IntelliSense ipch cache, old extension versions, orphaned workspace storage, CachedData, leftover VSIXs, caches and logs. Everything goes to the Trash. 清理 VS Code 自身不主动清理的空间",
  "version": "0.1.1",
  "publisher": "zhangming520",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhangMing520/vscode-cleaner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "clean",
    "cleanup",
    "cache",
    "ipch",
    "disk space",
    "cache cleaner",
    "free up space",
    "unused extensions",
    "old extensions",
    "workspace storage",
    "cachedata",
    "logs",
    "storage"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "vscode-cleaner.scanAndClean",
        "title": "%vscodeCleaner.scan.title%"
      }
    ],
    "configuration": {
      "title": "VS Code Cleaner",
      "properties": {
        "vscode-cleaner.minSizeMB": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "低于该可清理总量（MB）时仅提示、不打开详细报告；设为 0 表示始终打开报告。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run webview:build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "webview:build": "vite build",
    "webview:watch": "vite build --watch",
    "webview:typecheck": "vue-tsc --noEmit -p webview",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "naive-ui": "^2.45.3",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "vue": "^3.5.43",
    "vue-tsc": "^2.2.12"
  }
}
